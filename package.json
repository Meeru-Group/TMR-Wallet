{
  "name": "tmr-blockchain-por",
  "version": "2.0.0",
  "description": "Thanvi Testnet TMR Blockchain explorer and non-custodial wallet with PostgreSQL-backed real testnet state",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node init-db.js",
    "check": "node --check server.js && node --check blockchain.js && node --check database.js && node --check public/app.js && node --check public/wallet.js"
  },
  "keywords": [
    "blockchain",
    "proof-of-reputation",
    "tmr",
    "postgresql",
    "explorer"
  ],
  "author": "TMR Blockchain Contributors",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.16.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Meeru-Group/TMR-Blockchain.git"
  }
}
